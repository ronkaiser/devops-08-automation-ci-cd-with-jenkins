def gv

pipeline {   
    agent any
    tools {
        maven 'maven-3.9'
    }
    environment {
        APP_DIR = 'java-maven-app'
    }
    stages {
        stage("init") {
            steps {
                script {
                    gv = load "./java-maven-app/script.groovy"
                }
            }
        }
        stage("build jar") {
            steps {
                dir(env.APP_DIR) {
                    script {
                        gv.buildJar()
                    }
                }
            }
        }

        stage("build image") {
            steps {
                dir(env.APP_DIR) {
                    script {
                        gv.buildImage()
                    }
                }
            }
        }

        stage("deploy") {
            steps {
                script {
                    gv.deployApp()
                }
            }
        }               
    }
} 